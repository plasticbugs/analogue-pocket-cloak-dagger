# ==============================================================================
# Cloak & Dagger core RTL -- generated by tools/gen_qip.sh, do not edit
# ==============================================================================
set_global_assignment -name SEARCH_PATH [file join $::quartus(qip_path) ""]

# the package first: every module imports it
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "cloak_pkg.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "cloak_audio.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "cloak_core.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "cloak_main.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "cloak_reverb.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "cloak_slave.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "cloak_video.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "pokey.sv"]

# T65 6502 (mist-devel/T65), GHDL-converted -- Verilog-2005, not SystemVerilog
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) "../modules/cpu-t65/gen/t65.v"]
